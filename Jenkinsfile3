pipeline {
    agent any

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/sarangi99/CICD-SWIGGY.git'
            }
        }
        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('Package') {
            steps {
                sh 'mvn package'
            }
        }
        stage('Store Atrtifacts into S3') {
            steps {
               archiveArtifacts artifacts: 'target/*.war',
                                 fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
              sh 'sudo cp /var/lib/jenkins/workspace/pipeline01/target/*.war /home/maha/tomcat/webapps/'
            }
        }
    }
}